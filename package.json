{
  "name": "@memobit/angular",
  "version": "1.0.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "pack": "cd projects/memobit/src && npm pack",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test-coverage": "ng test --coverage=true",
    "publish": "cd projects/memobit/src && npm publish --access public",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,css,scss}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "private": true,
  "overrides": {
    "fast-uri@3": "3.1.8",
    "js-yaml": "4.3.2",
    "postcss": "8.5.28",
    "vite": "8.3.3"
  },
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-browser-dynamic": "22.2.0",
    "@angular/router": "22.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "22.0.1",
    "@angular-devkit/build-angular": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@eslint/js": "9.39.4",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.0",
    "jsdom": "27.3.0",
    "ng-packagr": "22.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
